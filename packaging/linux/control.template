Package: peero
Version: __VERSION__
Section: net
Priority: optional
Architecture: amd64
Depends: libgtk-3-0, libglib2.0-0, libblkid1, liblzma5, libmpv2, libgstreamer1.0-0, libgstreamer-plugins-base1.0-0, gstreamer1.0-plugins-base, gstreamer1.0-plugins-good, gstreamer1.0-libav, pulseaudio-utils, ffmpeg
